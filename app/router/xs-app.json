    },
    {
      "source": "^/greetinui/(.*)$",
      "target": "/greetinui/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    },
    {
      "source": "^/dashboard/(.*)$",
      "target": "/dashboard/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
