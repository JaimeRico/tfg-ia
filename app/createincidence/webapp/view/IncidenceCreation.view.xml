<mvc:View
    controllerName="tfgia.createincidence.controller.IncidenceCreation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="page" title="Crear incidencia">
        <content>
            <VBox class="sapUiSmallMargin" width="100%">
                <MessageStrip
                    text="Perfil simulado: Empleado. Desde esta pantalla se crea una incidencia y después puede consultarse en 'Mis incidencias'."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <Label text="Asunto" />
                <Input id="subjectInput" placeholder="Ejemplo: No puedo acceder a mi nómina" />

                <Label text="Descripción" class="sapUiSmallMarginTop" />
                <TextArea
                    id="bodyInput"
                    rows="6"
                    width="100%"
                    placeholder="Describe la incidencia con el mayor detalle posible" />

                <Label text="Idioma" class="sapUiSmallMarginTop" />
                <Input id="languageInput" value="es" width="8rem" />

                <HBox class="sapUiSmallMarginTop" renderType="Bare">
                    <Button
                        text="Crear incidencia"
                        type="Emphasized"
                        press=".onCreateIncident" />

                    <Button
                        text="Ver mis incidencias"
                        class="sapUiTinyMarginBegin"
                        press=".onGoToMyIncidents" />
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
