<mvc:View
    controllerName="dashboard.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
    displayBlock="true">

    <Page title="Dashboard de Incidencias" backgroundDesign="List">
        <content>
            <VBox class="sapUiSmallMargin">

                <!-- KPI TILES -->
                <Title text="Resumen General" level="H2" class="sapUiSmallMarginBottom sapUiSmallMarginTop"/>
                <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiMediumMarginBottom">
                    <l:content>
                        <GenericTile header="Total" subheader="Incidencias registradas">
                            <tileContent>
                                <TileContent unit="incidencias">
                                    <content>
                                        <NumericContent value="{mainModel>/kpis/total}" icon="sap-icon://list" valueColor="Neutral"/>
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile header="Abiertas" subheader="En curso">
                            <tileContent>
                                <TileContent unit="incidencias">
                                    <content>
                                        <NumericContent value="{mainModel>/kpis/abiertas}" icon="sap-icon://alert" valueColor="Critical"/>
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile header="Cerradas" subheader="Resueltas">
                            <tileContent>
                                <TileContent unit="incidencias">
                                    <content>
                                        <NumericContent value="{mainModel>/kpis/cerradas}" icon="sap-icon://accept" valueColor="Good"/>
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>
                        <GenericTile header="Revisión" subheader="Necesitan revisión">
                            <tileContent>
                                <TileContent unit="incidencias">
                                    <content>
                                        <NumericContent value="{mainModel>/kpis/needsReview}" icon="sap-icon://flag" valueColor="Error"/>
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>
                    </l:content>
                </l:Grid>

                <!-- CHARTS -->
                <Title text="Distribución" level="H2" class="sapUiSmallMarginBottom"/>
                <l:Grid defaultSpan="XL6 L6 M12 S12" class="sapUiMediumMarginBottom">
                    <l:content>

                        <Panel headerText="Por Departamento" expandable="false" class="sapUiSmallMarginBottom">
                            <viz:VizFrame id="chartDep" vizType="donut" height="300px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{mainModel>/departamento}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="Departamento" value="{dimension}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="Total" value="{total}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="color" type="Dimension" values="Departamento"/>
                                    <vizFeeds:FeedItem uid="size" type="Measure" values="Total"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </Panel>

                        <Panel headerText="Por Categoría" expandable="false" class="sapUiSmallMarginBottom">
                            <viz:VizFrame id="chartCat" vizType="donut" height="300px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{mainModel>/categoria}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="Categoría" value="{dimension}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="Total" value="{total}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="color" type="Dimension" values="Categoría"/>
                                    <vizFeeds:FeedItem uid="size" type="Measure" values="Total"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </Panel>

                        <Panel headerText="Por Estado" expandable="false" class="sapUiSmallMarginBottom">
                            <viz:VizFrame id="chartEst" vizType="donut" height="300px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{mainModel>/estado}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="Estado" value="{dimension}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="Total" value="{total}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="color" type="Dimension" values="Estado"/>
                                    <vizFeeds:FeedItem uid="size" type="Measure" values="Total"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </Panel>

                        <Panel headerText="Por Mes" expandable="false" class="sapUiSmallMarginBottom">
                            <viz:VizFrame id="chartMes" vizType="line" height="300px" width="100%"
                                uiConfig="{applicationSet:'fiori'}">
                                <viz:dataset>
                                    <vizData:FlattenedDataset data="{mainModel>/mes}">
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition name="Mes" value="{dimension}"/>
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition name="Total" value="{total}"/>
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Mes"/>
                                    <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Total"/>
                                </viz:feeds>
                            </viz:VizFrame>
                        </Panel>

                    </l:content>
                </l:Grid>

            </VBox>
        </content>
    </Page>
</mvc:View>
