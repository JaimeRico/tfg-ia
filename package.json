{
  "name": "tfg-ia",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@cap-js/hana": "^2.1.2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0",
    "csv-parser": "^3.2.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-greeting-ui": "cds watch --open greetingui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-createincidence": "cds watch --open tfgia.createincidence/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy tfg-ia --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && /usr/local/bin/mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-dashboard": "cds watch --open dashboard/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/greeting-ui",
    "app/dashboard"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "auth": {
        "kind": "dummy"
      }
    },
    "services": {
      "DashboardService": {
        "impl": "srv/dashboard-service.js"
      },
      "IncidenciasService": {
        "impl": "srv/service.js"
      }
    }
  }
}
