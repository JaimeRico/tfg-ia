        },
        "priority": {
          "type": "tfg.Priority"
        },
        "type": {
          "type": "tfg.TicketType"
        },
        "queue": {
          "type": "tfg.Queue"
        },
        "department": {
          "type": "tfg.Department"
        },
        "category": {
          "type": "tfg.IncidentCategory"
        },
